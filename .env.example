# Server Configuration
PORT=3000

# Supabase Local Simulation / Live Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://postgres:local_dev_password@localhost:54322/postgres

# Gemini API Integration
GEMINI_API_KEY=your-gemini-api-key

# Hostinger Webhook Credentials
WEBHOOK_SECRET=your-hostinger-webhook-verification-secret

# Hostinger SMTP Outbound Credentials
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password

# Sarvam AI (LLM + Document AI OCR for scanned PDF pages)
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_MAX_TOKENS=8192
SARVAM_DOC_LANGUAGE=en-IN
SARVAM_OCR_ENABLED=true

# Document section search: token budget for document context per query (default 60000, Groq 20000)
DOC_CONTEXT_BUDGET_TOKENS=

# Self-hosted PII redaction service (services/redactor). Unset = local pattern matching only.
REDACTION_SERVICE_URL=
REDACTION_SERVICE_TOKEN=
